+# Encoders aceitos no caminho de montagem: allowlist validada, nunca
+# interpolada em shell. vaapi fica de fora porque este caminho não faz o
+# setup de device que ele exige.
+VIDEO_ENCODERS = ("libx264", "h264_videotoolbox", "h264_nvenc")
+HARDWARE_ENCODERS = ("h264_videotoolbox", "h264_nvenc")
+HWACCELS = ("", "videotoolbox")
+
+
+def video_output_args(encoder: str) -> list[str]:
+    """Args de saída de vídeo por encoder. Hardware usa teto de bitrate (sem
+    -crf, que é do x264); software fica limitado a preset rápido + 2 threads."""
+    if encoder == "h264_videotoolbox":
+        return ["-c:v", encoder, "-allow_sw", "0", "-b:v", "8M", "-pix_fmt", "yuv420p"]
+    if encoder == "h264_nvenc":
+        return ["-c:v", encoder, "-b:v", "8M", "-pix_fmt", "yuv420p"]
+    if encoder == "libx264":
+        return ["-c:v", encoder, "-preset", "veryfast", "-crf", "20",
+                "-threads", "2", "-pix_fmt", "yuv420p"]
+    raise ValueError("encoder não suportado neste caminho")
+
+
+SEGMENT_MAX_SECONDS = 5
+
+
+def _to_frame(time_seconds: float, fps: float) -> int:
+    return int(math.floor(float(time_seconds) * float(fps) + 0.5))
+
+
+def render_intervals(plan: dict) -> list[tuple[int, int]]:
+    """Particiona a timeline em intervalos de frames [start, end).
+
+    Bordas nos inícios/fins dos clipes de vídeo (contrato V1/V2) mais 0 e a
+    duração total; cada trecho é subdividido até o teto de 5 segundos. Trechos
+    sequenciais cobrem toda a duração sem sobreposição.
+    """
+    fps = float(plan["fps"])
+    if not math.isfinite(fps) or fps <= 0:
+        raise RuntimeError("fps do plano inválido para intervalos")
+    total = _to_frame(float(plan["duration"]), fps)
+    if total <= 0:
+        raise RuntimeError("duração do plano inválida para intervalos")
+    max_frames = max(1, int(SEGMENT_MAX_SECONDS * fps))
+    edges = {0, total}
+    for clip in plan.get("video_clips", []):
+        edges.add(min(total, max(0, _to_frame(clip["timeline_start"], fps))))
+        edges.add(min(total, max(0, _to_frame(clip["timeline_end"], fps))))
+    bounds = sorted(edges)
+    intervals: list[tuple[int, int]] = []
+    for seg_start, seg_end in zip(bounds, bounds[1:]):
+        start = seg_start
+        while seg_end - start > max_frames:
+            intervals.append((start, start + max_frames))
+            start += max_frames
+        intervals.append((start, seg_end))
+    return intervals
+
+
+def slice_render_plan(plan: dict, start_frame: int, end_frame: int) -> dict:
+    """Recorta o plano para o intervalo [start_frame, end_frame), com tempos
+    locais. Sobreposição de vídeo além do contrato V1/V2 é rejeitada em vez
+    de abrir entradas ilimitadas. Não muta o plano original."""
+    fps = float(plan["fps"])
+
+    def slice_clip(clip: dict) -> dict | None:
+        clip_start_frame = _to_frame(clip["timeline_start"], fps)
+        clip_end_frame = _to_frame(clip["timeline_end"], fps)
+        local_start = max(clip_start_frame, start_frame)
+        local_end = min(clip_end_frame, end_frame)
+        if local_end <= local_start:
+            return None
+        speed = float(clip.get("speed") or 1.0)
+        span_seconds = (local_end - local_start) / fps
+        out = dict(clip)
+        out["start"] = float(clip.get("start", 0.0)) + ((local_start - clip_start_frame) / fps) * speed
+        out["source_duration"] = span_seconds * speed
+        out["render_duration"] = span_seconds
+        out["end"] = out["start"] + out["source_duration"]
+        out["timeline_start"] = (local_start - start_frame) / fps
+        out["timeline_end"] = (local_end - start_frame) / fps
+        if local_start > clip_start_frame:
+            out.pop("transition_in", None)
+        if local_end < clip_end_frame:
+            out.pop("transition_out", None)
+        return out
+
+    def slice_group(key: str) -> list[dict]:
+        return [c for c in (slice_clip(clip) for clip in plan.get(key, [])) if c is not None]
+
+    video_clips = slice_group("video_clips")
+    if len(video_clips) > 2:
+        raise RuntimeError(
+            f"sobreposição de {len(video_clips)} clipes de vídeo excede o contrato V1/V2 "
+            f"no intervalo [{start_frame},{end_frame})"
+        )
+    return {
+        **plan,
+        "duration": (end_frame - start_frame) / fps,
+        "video_clips": video_clips,
+        "audio_clips": [],
+        "overlay_clips": slice_group("overlay_clips"),
+        "text_clips": slice_group("text_clips"),
+    }
+
+
+class _AttemptFailed(RuntimeError):
+    def __init__(self, message: str, cmd: list[str] | None = None):
+        super().__init__(message)
+        self.cmd = cmd or []
+
+
+def _mixed_audio_filter(labels: list[str], duration: float) -> str:
+    if labels:
+        mix_inputs = "".join(f"[{label}]" for label in labels)
+        return (
+            f"{mix_inputs}amix=inputs={len(labels)}:duration=longest:dropout_transition=0:normalize=0,"
+            f"atrim=0:{duration:.6f},asetpts=PTS-STARTPTS[aout]"
+        )
+    return f"anullsrc=channel_layout=stereo:sample_rate=48000:d={duration:.6f}[aout]"
+
+
+def _render_segmented_video(plan: dict, work_dir: Path, encoder: str, hwaccel: str) -> tuple[Path, int]:
+    """Renderiza o vídeo em trechos sequenciais (≤5s, ≤2 entradas cada, sem
+    áudio) e concatena com -c:v copy. Devolve (vídeo concatenado, nº trechos)."""
+    intervals = render_intervals(plan)
+    seg_paths = []
+    for idx, (start_frame, end_frame) in enumerate(intervals):
+        sliced = slice_render_plan(plan, start_frame, end_frame)
+        seg_work = work_dir / f"seg_{idx:04d}"
+        seg_work.mkdir(parents=True, exist_ok=True)
+        seg_path = seg_work / "video.mp4"
+        cmd, _ = build_project_ffmpeg_command(
+            sliced, seg_path, seg_work, encoder=encoder, hwaccel=hwaccel, include_audio=False)
+        try:
+            proc = run_proc(cmd, capture_output=True, text=True, timeout=7200)
+        except Exception as exc:
+            raise _AttemptFailed(f"segmento {idx} [{start_frame},{end_frame}): {exc}", cmd) from exc
+        if proc.returncode != 0:
+            raise _AttemptFailed(
+                f"segmento {idx} [{start_frame},{end_frame}): {proc.stderr.strip()[-1500:]}", cmd)
+        if not seg_path.is_file() or not source_has_video(seg_path):
+            raise _AttemptFailed(f"segmento {idx} [{start_frame},{end_frame}) sem vídeo", cmd)
+        seg_paths.append(seg_path)
+    concat_file = work_dir / "concat.txt"
+    concat_file.write_text(
+        "".join(f"file '{ffconcat_escape(p)}'\n" for p in seg_paths), encoding="utf-8")
+    video_path = work_dir / "video-concat.mp4"
+    concat_cmd = ["ffmpeg", "-y", "-f", "concat", "-safe", "0", "-i", str(concat_file),
+                  "-c:v", "copy", str(video_path)]
+    try:
+        proc = run_proc(concat_cmd, capture_output=True, text=True, timeout=1800)
+    except Exception as exc:
+        raise _AttemptFailed(f"concat de vídeo: {exc}", concat_cmd) from exc
+    if proc.returncode != 0 or not video_path.is_file():
+        raise _AttemptFailed(f"concat de vídeo: {proc.stderr.strip()[-1500:]}", concat_cmd)
+    return video_path, len(seg_paths)
+
+
+def _mux_global_audio(plan: dict, video_path: Path, output_path: Path, work_dir: Path) -> list[str]:
+    """Mistura o áudio global uma única vez (beds do plano cheio) e anexa ao
+    vídeo concatenado. Devolve o comando para diagnóstico."""
+    cmd: list[str] = ["ffmpeg", "-y", "-threads", "2", "-i", str(video_path)]
+    labels = []
+    for idx, (bed_path, _clip) in enumerate(bake_project_audio_beds(plan, work_dir)):
+        cmd += ["-threads", "2", "-i", str(bed_path)]
+        labels.append(f"gaud{idx}")
+    bed_filters = [audio_bed_filter(idx + 1, label) for idx, label in enumerate(labels)]
+    filter_complex = ";".join([*bed_filters, _mixed_audio_filter(labels, float(plan["duration"]))])
+    cmd += ["-filter_complex", filter_complex, "-filter_complex_threads", "1",
+            "-map", "0:v", "-map", "[aout]",
+            "-c:v", "copy", "-c:a", "aac", "-ar", "48000", "-ac", "2",
+            "-movflags", "+faststart", str(output_path)]
+    try:
+        proc = run_proc(cmd, capture_output=True, text=True, timeout=1800)
+    except Exception as exc:
+        raise _AttemptFailed(f"mixagem global: {exc}", cmd) from exc
+    if proc.returncode != 0:
+        raise _AttemptFailed(f"mixagem global: {proc.stderr.strip()[-1500:]}", cmd)
+    return cmd
+
