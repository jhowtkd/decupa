# Nome usado pelo Caddy. Em produção, use o domínio que aponta para este host.
DECUPA_DOMAIN=localhost

# auto = certificado público do Caddy; internal = CA local; off = HTTP.
DECUPA_TLS_MODE=auto

# Obrigatória: o compose falha antes de criar os serviços quando está vazia.
DECUPA_AUTH_PASSWORD=troque-esta-senha

# Inclua o domínio público e nomes usados para diagnóstico dentro da rede.
# Se vazio, o compose deriva o domínio acima e acrescenta o nome do serviço.
DECUPA_ALLOWED_HOSTS=

# Portas publicadas somente pelo Caddy. Para uma LAN, 80/443 são convenientes;
# use outras portas se já houver um proxy no host.
DECUPA_HTTP_PORT=80
DECUPA_HTTPS_PORT=443

# A variante cpu não carrega CUDA. Para GPU NVIDIA, use o perfil abaixo: ele fixa
# a variante cuda, então esta linha só vale sem o perfil.
DECUPA_VARIANT=cpu
DECUPA_IMAGE=decupa

# Perfil de GPU NVIDIA (docs/implantacao-docker.md). Descomente para ativar: o
# perfil fixa a variante cuda e reserva a placa para transcrição e render.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# Opcional com o perfil: DECUPA_SPEECH_DEVICE=cpu mantém a transcrição na CPU.
# DECUPA_SPEECH_DEVICE=cpu

# O UID/GID define o dono dos arquivos nos volumes bind mount.
DECUPA_UID=1000
DECUPA_GID=1000

# Limita a fila de trabalho pesado no servidor compartilhado. Com GPU, mantenha 1:
# o app não escolhe cartão por job, então dois jobs dividiriam a memória da placa.
DECUPA_JOB_CONCURRENCY=1

# R2 como passagem (opcional): navegador envia direto; VPS importa, valida e
# apaga a cópia no R2. Configure as quatro juntas. Bucket privado, classe Standard.
# Guia de bucket, permissões e CORS: docs/upload-r2.md
DECUPA_R2_ACCOUNT_ID=
DECUPA_R2_BUCKET=
DECUPA_R2_ACCESS_KEY_ID=
DECUPA_R2_SECRET_ACCESS_KEY=

# Para bind mounts, troque no docker-compose.yml, por exemplo:
#   - /srv/decupa/cache:/home/decupa/.cache
#   - /srv/decupa/config:/home/decupa/.decupa
#   - /srv/decupa/projects:/data/projects
#   - /srv/decupa/media:/data/media
