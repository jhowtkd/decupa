# Nome usado pelo Caddy. Em produção, use o domínio que aponta para este host.
DECUPA_DOMAIN=localhost

# auto = certificado público do Caddy; internal = CA local; off = HTTP.
DECUPA_TLS_MODE=auto

# Obrigatória: o compose falha antes de criar os serviços quando está vazia.
DECUPA_AUTH_PASSWORD=troque-esta-senha

# Inclua o domínio público e nomes usados para diagnóstico dentro da rede.
# Se vazio, o compose deriva o domínio acima e acrescenta o nome do serviço.
DECUPA_ALLOWED_HOSTS=

# Portas publicadas somente pelo Caddy. Para uma LAN, 80/443 são convenientes;
# use outras portas se já houver um proxy no host.
DECUPA_HTTP_PORT=80
DECUPA_HTTPS_PORT=443

# A variante cpu não carrega CUDA. A imagem cuda fica disponível para um host
# com NVIDIA Container Toolkit quando o compose for estendido para GPU.
DECUPA_VARIANT=cpu
DECUPA_IMAGE=decupa

# O UID/GID define o dono dos arquivos nos volumes bind mount.
DECUPA_UID=1000
DECUPA_GID=1000

# Limita a fila de trabalho pesado no servidor compartilhado.
DECUPA_JOB_CONCURRENCY=1

# Para bind mounts, troque no docker-compose.yml, por exemplo:
#   - /srv/decupa/cache:/home/decupa/.cache
#   - /srv/decupa/config:/home/decupa/.decupa
#   - /srv/decupa/projects:/data/projects
#   - /srv/decupa/media:/data/media
