{
	# O modo é selecionado pelo operador em DECUPA_TLS_MODE. O bloco global
	# desliga o HTTPS automático somente no modo off.
	{$DECUPA_CADDY_GLOBAL}
}

# No modo off o site precisa do esquema http://; sem ele o Caddy continua
# servindo só na porta 443. O endereço vem pronto do entrypoint.
{$DECUPA_CADDY_SITE} {
	{$DECUPA_CADDY_TLS}

	# O padrão do reverse_proxy já repassa o Host original (com a porta, que o
	# Decupa confere) e gera X-Forwarded-* descartando os valores do cliente.
	reverse_proxy decupa:7788 {
		transport http {
			read_timeout 30m
			write_timeout 30m
			read_buffer 0
		}
	}
}
